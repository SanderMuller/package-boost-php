#!/usr/bin/env php
<?php declare(strict_types=1);

use SanderMuller\PackageBoostPhp\Commands\GitattributesCommand;
use SanderMuller\PackageBoostPhp\Commands\LeanCommand;
use Symfony\Component\Console\Application;

(function (): void {
    $autoloadCandidates = [
        __DIR__ . '/../vendor/autoload.php',
        __DIR__ . '/../../../autoload.php',
    ];

    foreach ($autoloadCandidates as $candidate) {
        if (file_exists($candidate)) {
            require $candidate;
            break;
        }
    }

    $app = new Application('package-boost-php');

    $commands = [];
    foreach ([new LeanCommand(), new GitattributesCommand()] as $command) {
        $name = $command->getName();
        if (is_string($name) && str_starts_with($name, 'package-boost-php:')) {
            $command->setName(substr($name, strlen('package-boost-php:')));
        }
        $commands[] = $command;
    }

    $app->addCommands($commands);

    $app->run();
})();
